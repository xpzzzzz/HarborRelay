COMPOSE_PROJECT_NAME=harborrelay
AGENT_FRAMEWORK=event_driven_multi_agent
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mindbridge-qwen2.5-7b-ft:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_PROVIDER=ollama
FINETUNED_MODEL_NAME=mindbridge-qwen2.5-7b-ft:latest
FINETUNED_MODEL_DIR=models/mindbridge-qwen2.5-7b-ft
FINETUNED_MODEL_FILE=mindbridge-qwen2.5-7b-ft-q4_k_m.gguf
DATABASE_URL=mysql+pymysql://harborrelay:harborrelay@127.0.0.1:13306/harborrelay?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:16379/0
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_REQUIRED=false
CHROMA_COLLECTION_NAME=harborrelay_knowledge_ollama
CHROMA_PERSIST_DIR=data/chroma
CHROMA_SNAPSHOT_DIR=data/chroma-snapshots
ANONYMIZED_TELEMETRY=false
EMBEDDING_TIMEOUT_SECONDS=120
TOOL_QUEUE_ENABLED=true
ALERT_EMAIL_DELIVERY_MODE=log
ALERT_EMAIL_SUBJECT_PREFIX=[HarborRelay 高风险预警]
EXCEL_PATH=data/harborrelay-risk-ledger.xlsx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JUDGE_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
